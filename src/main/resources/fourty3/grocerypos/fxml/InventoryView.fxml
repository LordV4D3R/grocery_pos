<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fourty3.grocerypos.controller.InventoryController"
            styleClass="content-root">

    <top>
        <VBox spacing="10" styleClass="panel">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Label text="Quản lý kho / Nhập hàng" styleClass="section-title"/>

            <HBox spacing="10">
                <TextField fx:id="txtSearch" promptText="Tìm theo tên sản phẩm..." prefWidth="260"/>
                <Button text="Tìm kiếm" onAction="#handleSearch"/>
                <Button text="Làm mới" onAction="#handleRefresh"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10" styleClass="panel">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <TableView fx:id="productTable" prefHeight="500">
                <columns>
                    <TableColumn fx:id="colRowNumber" text="Thứ tự" prefWidth="70" sortable="false"/>
                    <TableColumn fx:id="colProductCode" text="Mã SP" prefWidth="90" sortable="false"/>
                    <TableColumn fx:id="colName" text="Tên sản phẩm" prefWidth="220"/>
                    <TableColumn fx:id="colImportPrice" text="Giá nhập" prefWidth="130"/>
                    <TableColumn fx:id="colStockQuantity" text="Tồn kho" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <right>
        <VBox spacing="12" styleClass="panel" prefWidth="320">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Label text="Thông tin nhập hàng" styleClass="section-title"/>

            <Label text="Sản phẩm đã chọn:"/>
            <Label fx:id="lblSelectedProduct" text="Chưa chọn sản phẩm" styleClass="selected-product"/>

            <Label text="Tồn kho hiện tại:"/>
            <Label fx:id="lblCurrentStock" text="0"/>

            <Label text="Giá nhập hiện tại:"/>
            <Label fx:id="lblCurrentImportPrice" text="0 VNĐ"/>

            <Label text="Số lượng nhập thêm"/>
            <TextField fx:id="txtImportQuantity" promptText="Nhập số lượng"/>

            <Label text="Giá nhập mới"/>
            <TextField fx:id="txtNewImportPrice" promptText="Nhập giá nhập (vd: 2 000 000)"/>

            <Button text="Nhập hàng" onAction="#handleImportStock" styleClass="checkout-button"/>
        </VBox>
    </right>

</BorderPane>