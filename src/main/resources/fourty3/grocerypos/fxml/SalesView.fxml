<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fourty3.grocerypos.controller.SalesController"
            styleClass="content-root">

    <left>
        <VBox spacing="10" styleClass="panel">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Label text="Tìm sản phẩm" styleClass="section-title"/>
            <TextField fx:id="txtSearch" promptText="Nhập tên sản phẩm..."/>
            <Button text="Tìm kiếm" onAction="#handleSearch"/>
            <ListView fx:id="lvProducts" prefWidth="320" prefHeight="500"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="12" styleClass="panel">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Label text="Thao tác bán hàng" styleClass="section-title"/>

            <Label text="Sản phẩm đã chọn:"/>
            <Label fx:id="lblSelectedProduct" text="Chưa chọn sản phẩm" styleClass="selected-product"/>

            <Label text="Giá bán:"/>
            <Label fx:id="lblSelectedPrice" text="0 VNĐ"/>

            <Label text="Tồn kho:"/>
            <Label fx:id="lblSelectedStock" text="0"/>

            <Label text="Số lượng"/>
            <TextField fx:id="txtQuantity"
                       promptText="Nhập số lượng"
                       onAction="#handleAddToCart"/>

            <HBox spacing="10">
                <Button text="Thêm vào đơn" onAction="#handleAddToCart"/>
                <Button text="Xoá dòng đã chọn" onAction="#handleRemoveSelectedItem"/>
            </HBox>
        </VBox>
    </center>

    <right>
        <VBox spacing="12" styleClass="panel">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Label text="Hoá đơn tạm" styleClass="section-title"/>

            <TableView fx:id="cartTable" prefWidth="520" prefHeight="450">
                <columns>
                    <TableColumn fx:id="colProductName" text="Sản phẩm" prefWidth="180"/>
                    <TableColumn fx:id="colQuantity" text="SL" prefWidth="60"/>
                    <TableColumn fx:id="colUnitPrice" text="Giá bán" prefWidth="120"/>
                    <TableColumn fx:id="colLineTotal" text="Thành tiền" prefWidth="150"/>
                </columns>
            </TableView>

            <Label text="Tổng tiền" styleClass="section-title"/>
            <Label fx:id="lblTotalAmount" text="0 VNĐ" styleClass="total-amount"/>

            <Button text="Thanh toán" onAction="#handleCheckout" styleClass="checkout-button"/>
        </VBox>
    </right>

</BorderPane>