<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fourty3.grocerypos.controller.ProductController"
            styleClass="content-root">

    <top>
        <VBox spacing="15" styleClass="panel">
            <BorderPane.margin>
                <Insets bottom="15"/>
            </BorderPane.margin>

            <Label text="Quản lý sản phẩm" styleClass="page-title"/>

            <HBox spacing="15">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Tên sản phẩm"/>
                    <TextField fx:id="txtName" promptText="Nhập tên SP"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Giá bán"/>
                    <TextField fx:id="txtSellingPrice" promptText="Ví dụ: 2000000"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Giá nhập"/>
                    <TextField fx:id="txtImportPrice" promptText="Ví dụ: 1500000"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Tồn kho"/>
                    <TextField fx:id="txtStockQuantity" promptText="Số lượng"/>
                </VBox>
            </HBox>

            <HBox spacing="10">
                <Button text="Thêm Mới" onAction="#handleAddProduct" styleClass="primary-button"/>
                <Button text="Cập Nhật" onAction="#handleUpdateProduct"/>
                <Button text="Xoá / Ngừng Bán" onAction="#handleDeleteProduct" styleClass="danger-button"/>
                <Button text="Mở Bán Lại" onAction="#handleReactivateProduct"/>
                <Button text="Làm Mới" onAction="#handleRefresh"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10" styleClass="panel">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtSearch" promptText="Tìm theo tên sản phẩm..." prefWidth="300"/>
                <Button text="Tìm kiếm" onAction="#handleSearch" styleClass="primary-button"/>
            </HBox>

            <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colRowNumber" text="STT" prefWidth="50" sortable="false" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colProductCode" text="Mã SP" prefWidth="100" sortable="false" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colName" text="Tên sản phẩm" prefWidth="250" style="-fx-alignment: CENTER-LEFT;"/>
                    <TableColumn fx:id="colSellingPrice" text="Giá bán" prefWidth="150" style="-fx-alignment: CENTER-RIGHT;"/>
                    <TableColumn fx:id="colImportPrice" text="Giá nhập" prefWidth="150" style="-fx-alignment: CENTER-RIGHT;"/>
                    <TableColumn fx:id="colStockQuantity" text="Tồn kho" prefWidth="100" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="120" style="-fx-alignment: CENTER;"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

</BorderPane>