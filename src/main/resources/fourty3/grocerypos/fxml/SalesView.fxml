<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fourty3.grocerypos.controller.SalesController"
            styleClass="content-root">

    <left>
        <VBox spacing="10" styleClass="panel" prefWidth="300">
            <BorderPane.margin>
                <Insets right="15"/>
            </BorderPane.margin>
            <Label text="Tìm sản phẩm" styleClass="section-title"/>
            <HBox spacing="5">
                <TextField fx:id="txtSearch" promptText="Nhập tên..." HBox.hgrow="ALWAYS"/>
                <Button text="Tìm" onAction="#handleSearch"/>
            </HBox>
            <ListView fx:id="lvProducts" VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="15" styleClass="panel">
            <Label text="Thao tác" styleClass="section-title"/>

            <VBox spacing="5">
                <Label text="Sản phẩm đang chọn:"/>
                <Label fx:id="lblSelectedProduct" text="Chưa chọn sản phẩm" style="-fx-font-weight: bold; -fx-text-fill: #0d6efd;"/>
            </VBox>

            <HBox spacing="20">
                <VBox spacing="5">
                    <Label text="Giá bán:"/>
                    <Label fx:id="lblSelectedPrice" text="0 VNĐ" style="-fx-font-weight: bold;"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Tồn kho:"/>
                    <Label fx:id="lblSelectedStock" text="0" style="-fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <VBox spacing="5">
                <Label text="Số lượng"/>
                <HBox spacing="10">
                    <TextField fx:id="txtQuantity" promptText="Nhập SL..." onAction="#handleAddToCart" HBox.hgrow="ALWAYS"/>
                    <Button text="Thêm" onAction="#handleAddToCart" styleClass="primary-button"/>
                </HBox>
            </VBox>

            <Button text="Xoá dòng đã chọn khỏi đơn" onAction="#handleRemoveSelectedItem" styleClass="danger-button" maxWidth="Infinity"/>
        </VBox>
    </center>

    <right>
        <VBox spacing="12" styleClass="panel" prefWidth="450">
            <BorderPane.margin>
                <Insets left="15"/>
            </BorderPane.margin>
            <Label text="Hoá đơn tạm" styleClass="section-title"/>

            <TableView fx:id="cartTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colProductName" text="Sản phẩm" prefWidth="150" style="-fx-alignment: CENTER-LEFT;"/>
                    <TableColumn fx:id="colQuantity" text="SL" prefWidth="50" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colUnitPrice" text="Giá bán" prefWidth="100" style="-fx-alignment: CENTER-RIGHT;"/>
                    <TableColumn fx:id="colLineTotal" text="Thành tiền" prefWidth="120" style="-fx-alignment: CENTER-RIGHT;"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Tổng tiền:" styleClass="section-title"/>
                <Label fx:id="lblTotalAmount" text="0 VNĐ" styleClass="total-amount"/>
            </HBox>

            <VBox spacing="5">
                <Label text="Khách hàng (tuỳ chọn)" />
                <HBox spacing="10">
                    <ComboBox fx:id="cbCustomer" promptText="Khách lẻ / Chọn để ghi nợ" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="Bỏ chọn" onAction="#handleClearCustomerSelection"/>
                </HBox>
            </VBox>

            <HBox spacing="10">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Khách đưa" />
                    <TextField fx:id="txtPaidAmount" promptText="Trống = trả đủ" />
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Còn nợ" />
                    <Label fx:id="lblRemainingAmount" text="0 VNĐ" styleClass="total-amount" style="-fx-text-fill: #dc3545;" />
                </VBox>
            </HBox>

            <Label fx:id="lblPaymentStatus" text="..." />

            <Button text="THANH TOÁN" onAction="#handleCheckout" styleClass="checkout-button" maxWidth="Infinity" prefHeight="45"/>
        </VBox>
    </right>

</BorderPane>