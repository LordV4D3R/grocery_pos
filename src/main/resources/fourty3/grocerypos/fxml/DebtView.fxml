<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="fourty3.grocerypos.controller.DebtController"
            styleClass="content-root">

    <top>
        <VBox spacing="10" styleClass="panel">
            <BorderPane.margin>
                <Insets bottom="15"/>
            </BorderPane.margin>
            <Label text="Quản lý công nợ" styleClass="page-title"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Tìm kiếm:"/>
                <TextField fx:id="txtSearch"
                           promptText="Nhập mã KH, tên khách, SĐT hoặc ID đơn..."
                           HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="15">
            <VBox styleClass="panel" HBox.hgrow="ALWAYS">
                <TableView fx:id="debtTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colRowNumber" text="STT" prefWidth="50" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colOrderId" text="Đơn" prefWidth="80" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colCustomerCode" text="Mã KH" prefWidth="90" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colCustomerName" text="Khách hàng" prefWidth="180" style="-fx-alignment: CENTER-LEFT;"/>
                        <TableColumn fx:id="colCreatedAt" text="Ngày bán" prefWidth="150" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colTotalAmount" text="Tổng tiền" prefWidth="120" style="-fx-alignment: CENTER-RIGHT;"/>
                        <TableColumn fx:id="colPaidAmount" text="Đã trả" prefWidth="120" style="-fx-alignment: CENTER-RIGHT;"/>
                        <TableColumn fx:id="colRemainingAmount" text="Còn nợ" prefWidth="120" style="-fx-alignment: CENTER-RIGHT;"/>
                        <TableColumn fx:id="colPaymentStatus" text="Trạng thái" prefWidth="130" style="-fx-alignment: CENTER;"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox spacing="15" styleClass="panel" prefWidth="380" minWidth="350">
                <Label text="Thao tác thu nợ" styleClass="section-title"/>

                <HBox spacing="20">
                    <VBox spacing="5">
                        <Label text="Đơn đang chọn"/>
                        <Label fx:id="lblSelectedOrder" text="Chưa chọn" style="-fx-font-weight: bold;"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Khách hàng"/>
                        <Label fx:id="lblSelectedCustomer" text="Chưa chọn" style="-fx-font-weight: bold;"/>
                    </VBox>
                </HBox>

                <VBox spacing="5">
                    <Label text="Số tiền khách còn nợ"/>
                    <Label fx:id="lblSelectedRemainingAmount" text="0 VNĐ" styleClass="total-amount" style="-fx-text-fill: #dc3545;"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Số tiền thu đợt này"/>
                    <TextField fx:id="txtCollectAmount" promptText="Nhập số tiền khách đưa"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Ghi chú"/>
                    <TextArea fx:id="txtNote" prefRowCount="2" wrapText="true"/>
                </VBox>

                <HBox spacing="10">
                    <Button text="Xác nhận thu" onAction="#handleCollectPayment" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="primary-button"/>
                    <Button text="Làm mới" onAction="#handleRefresh" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>

                <Label text="Lịch sử thu nợ của đơn này" styleClass="section-title">
                    <VBox.margin>
                        <Insets top="10"/>
                    </VBox.margin>
                </Label>

                <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colHistoryPaidAt" text="Ngày thu" prefWidth="130" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colHistoryAmount" text="Số tiền" prefWidth="100" style="-fx-alignment: CENTER-RIGHT;"/>
                        <TableColumn fx:id="colHistoryNote" text="Ghi chú" prefWidth="120" style="-fx-alignment: CENTER-LEFT;"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </HBox>
    </center>

</BorderPane>