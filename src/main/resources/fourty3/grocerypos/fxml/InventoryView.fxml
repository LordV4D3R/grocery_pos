<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fourty3.grocerypos.controller.InventoryController"
            styleClass="content-root">

    <top>
        <VBox spacing="10" styleClass="panel">
            <BorderPane.margin>
                <Insets bottom="15"/>
            </BorderPane.margin>
            <Label text="Quản lý kho / Nhập hàng" styleClass="page-title"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtSearch" promptText="Tìm theo tên sản phẩm..." prefWidth="300"/>
                <Button text="Tìm kiếm" onAction="#handleSearch" styleClass="primary-button"/>
                <Button text="Làm mới" onAction="#handleRefresh"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10" styleClass="panel">
            <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colRowNumber" text="STT" prefWidth="60" sortable="false" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colProductCode" text="Mã SP" prefWidth="100" sortable="false" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colName" text="Tên sản phẩm" prefWidth="250" style="-fx-alignment: CENTER-LEFT;"/>
                    <TableColumn fx:id="colImportPrice" text="Giá nhập" prefWidth="150" style="-fx-alignment: CENTER-RIGHT;"/>
                    <TableColumn fx:id="colStockQuantity" text="Tồn kho" prefWidth="100" style="-fx-alignment: CENTER;"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <right>
        <VBox spacing="15" styleClass="panel" prefWidth="350">
            <BorderPane.margin>
                <Insets left="15"/>
            </BorderPane.margin>
            <Label text="Thao tác nhập hàng" styleClass="section-title"/>

            <VBox spacing="5">
                <Label text="Sản phẩm đã chọn:"/>
                <Label fx:id="lblSelectedProduct" text="Chưa chọn sản phẩm" style="-fx-font-weight: bold; -fx-text-fill: #0d6efd;"/>
            </VBox>

            <HBox spacing="20">
                <VBox spacing="5">
                    <Label text="Tồn kho hiện tại:"/>
                    <Label fx:id="lblCurrentStock" text="0" style="-fx-font-weight: bold;"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Giá nhập hiện tại:"/>
                    <Label fx:id="lblCurrentImportPrice" text="0 VNĐ" style="-fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <VBox spacing="5">
                <Label text="Số lượng nhập thêm"/>
                <TextField fx:id="txtImportQuantity" promptText="Nhập số lượng"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Giá nhập mới"/>
                <TextField fx:id="txtNewImportPrice" promptText="Nhập giá mới (nếu thay đổi)"/>
            </VBox>

            <Button text="Xác nhận nhập hàng" onAction="#handleImportStock" styleClass="checkout-button" maxWidth="Infinity" prefHeight="40"/>
        </VBox>
    </right>

</BorderPane>