<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fourty3.grocerypos.controller.DebtHistoryController"
            styleClass="content-root">

    <top>
        <VBox spacing="15" styleClass="panel">
            <BorderPane.margin>
                <Insets bottom="15"/>
            </BorderPane.margin>

            <Label text="Lịch sử thu nợ tổng hợp" styleClass="page-title"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Tìm kiếm:"/>
                <TextField fx:id="txtSearch"
                           promptText="Nhập mã KH, tên khách, SĐT, ID đơn hoặc ghi chú..."
                           HBox.hgrow="ALWAYS"/>
                <Button text="Làm mới" onAction="#handleRefresh" styleClass="primary-button"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Tổng tiền đã thu theo danh sách đang hiển thị:" styleClass="section-title"/>
                <Label fx:id="lblTotalCollected" text="0 VNĐ" styleClass="total-amount"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox styleClass="panel">
            <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colRowNumber" text="STT" prefWidth="60" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colPaidAt" text="Ngày thu" prefWidth="160" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colOrderId" text="Đơn" prefWidth="100" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colCustomerCode" text="Mã KH" prefWidth="120" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colCustomerName" text="Khách hàng" prefWidth="200" style="-fx-alignment: CENTER-LEFT;"/>
                    <TableColumn fx:id="colAmountPaid" text="Số tiền thu" prefWidth="150" style="-fx-alignment: CENTER-RIGHT;"/>
                    <TableColumn fx:id="colNote" text="Ghi chú" prefWidth="250" style="-fx-alignment: CENTER-LEFT;"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

</BorderPane>